Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Displays:
      - Class: rviz_default_plugins/Grid
        Name: Ground Grid
        Enabled: true
        Alpha: 0.35
        Cell Size: 5
        Color: 120; 120; 120
        Plane: XY
        Plane Cell Count: 20
        Reference Frame: <Fixed Frame>
        Value: true

      - Class: rviz_default_plugins/TF
        Name: TF
        Enabled: true
        Frame Timeout: 15
        Frames:
          All Enabled: false
        Marker Scale: 0.6
        Show Arrows: true
        Show Axes: true
        Show Names: false
        Tree:
          {}
        Update Interval: 0
        Value: true

      - Class: rviz_default_plugins/RobotModel
        Name: Interceptor
        Enabled: true
        Description Source: Topic
        Description Topic:
          Value: /robot_description
          Depth: 5
          Durability Policy: Transient Local
          History Policy: Keep Last
          Reliability Policy: Reliable
        Visual Enabled: true
        Collision Enabled: false
        Alpha: 1
        Value: true

      - Class: rviz_default_plugins/RobotModel
        Name: Target Drone
        Enabled: true
        Description Source: Topic
        Description Topic:
          Value: /target_description
          Depth: 5
          Durability Policy: Transient Local
          History Policy: Keep Last
          Reliability Policy: Reliable
        Visual Enabled: true
        Collision Enabled: false
        Alpha: 1
        Value: true

      - Class: rviz_default_plugins/MarkerArray
        Name: Tracks
        Enabled: true
        Topic:
          Value: /tracks/markers
          Depth: 5
          Durability Policy: Transient Local
          History Policy: Keep Last
          Reliability Policy: Reliable
        Value: true

      - Class: rviz_default_plugins/MarkerArray
        Name: Guidance Vectors
        Enabled: true
        Topic:
          Value: /guidance/vectors
          Depth: 5
          Durability Policy: Transient Local
          History Policy: Keep Last
          Reliability Policy: Reliable
        Value: true

      - Class: rviz_default_plugins/Image
        Name: Left Camera
        Enabled: true
        Image Topic:
          Value: /stereo/left/image_raw
          Depth: 2
          Durability Policy: Volatile
          History Policy: Keep Last
          Reliability Policy: Reliable
        Max Value: 1
        Median window: 5
        Min Value: 0
        Normalize Range: true
        Queue Size: 2
        Transport hint: raw
        Unreliable: false
        Value: true

      - Class: rviz_default_plugins/Image
        Name: Right Camera
        Enabled: true
        Image Topic:
          Value: /stereo/right/image_raw
          Depth: 2
          Durability Policy: Volatile
          History Policy: Keep Last
          Reliability Policy: Reliable
        Max Value: 1
        Median window: 5
        Min Value: 0
        Normalize Range: true
        Queue Size: 2
        Transport hint: raw
        Unreliable: false
        Value: true

      - Class: rviz_default_plugins/Image
        Name: Detection Overlay
        Enabled: true
        Image Topic:
          Value: /target/detection_viz
          Depth: 2
          Durability Policy: Volatile
          History Policy: Keep Last
          Reliability Policy: Reliable
        Max Value: 1
        Median window: 5
        Min Value: 0
        Normalize Range: true
        Queue Size: 2
        Transport hint: raw
        Unreliable: false
        Value: true

      - Class: rviz_default_plugins/Map
        Name: Depth Map
        Enabled: true
        Topic:
          Value: /stereo/depth
          Depth: 2
          Durability Policy: Volatile
          History Policy: Keep Last
          Reliability Policy: Reliable
        Alpha: 0.7
        Color Scheme: map
        Draw Behind: false
        Unreliable: false
        Use Timestamp: false
        Value: true

    Enabled: true
    Global Options:
      Background Color: 30; 30; 38
      Default Light: true
      Fixed Frame: map
      Frame Rate: 30
    Name: Displays
    Tree:
      Displays:
        Items:
          - Class: rviz_default_plugins/Grid
            Name: Ground Grid
          - Class: rviz_default_plugins/TF
            Name: TF
          - Class: rviz_default_plugins/RobotModel
            Name: Interceptor
          - Class: rviz_default_plugins/RobotModel
            Name: Target Drone
          - Class: rviz_default_plugins/MarkerArray
            Name: Tracks
          - Class: rviz_default_plugins/MarkerArray
            Name: Guidance Vectors
          - Class: rviz_default_plugins/Image
            Name: Left Camera
          - Class: rviz_default_plugins/Image
            Name: Right Camera
          - Class: rviz_default_plugins/Image
            Name: Detection Overlay
          - Class: rviz_default_plugins/Map
            Name: Depth Map
        Name: Displays
        Splitter Ratio: 0.5
      Toolbars:
        ToolButtonStyle: 2
        toolbarNames:
          - Interact
          - Move Camera
          - Select
          - Focus Camera
          - Measure
          - 2D Pose Estimate
          - 2D Goal Pose
          - Publish Point
        toolbarActions:
          - Interact
          - Move Camera
          - Select
          - Focus Camera
          - Measure
          - 2D Pose Estimate
          - 2D Goal Pose
          - Publish Point
        toolbarVisible:
          - true
          - true
          - true
          - true
          - true
          - true
          - true
    Value: true

  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: ""

  - Class: rviz_common/Views
    Name: Views
    Value: true
    Views:
      Current:
        Class: rviz_default_plugins/Orbit
        Distance: 26
        Enable Stereo Rendering:
          Stereo Eye Separation: 0.06
          Stereo Focal Distance: 1
          Swap Stereo Eyes: false
          Value: false
        Focal Point:
          X: 8
          Y: 7
          Z: 6
        Focal Shape Fixed Size: true
        Focal Shape Size: 0.05
        Invert Z Axis: false
        Name: Current View
        Near Clip Distance: 0.05
        Pitch: 0.42
        Target Frame: <Fixed Frame>
        Value: Orbit (rviz)
        Yaw: 0.6
      Saved:
        - Class: rviz_default_plugins/Orbit
          Distance: 26
          Focal Point:
            X: 8
            Y: 7
            Z: 6
          Name: Overview
          Pitch: 0.42
          Target Frame: <Fixed Frame>
          Value: Orbit (rviz)
          Yaw: 0.6
        - Class: rviz_default_plugins/Orbit
          Distance: 12
          Focal Point:
            X: 8
            Y: 7
            Z: 8
          Name: Close
          Pitch: 0.35
          Target Frame: <Fixed Frame>
          Value: Orbit (rviz)
          Yaw: 0.6
        - Class: rviz_default_plugins/TopDownOrtho
          Angle: 0
          Name: Top Down
          Near Clip Distance: 0.01
          Scale: 42
          Target Frame: <Fixed Frame>
          Value: TopDownOrtho (rviz)
          X: 8
          Y: 7
Window Geometry:
  Height: 1000
  Hide Left Dock: false
  Hide Right Dock: false
  Views:
    collapsed: false
  Width: 1900
  X: 40
  Y: 30
