<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="interceptor_quadrotor">

  <!--
    Visual model: Holybro X500 V2 quadrotor (500 mm wheelbase, carbon-fibre
    frame), meshes from PX4-gazebo-models (BSD-3-Clause), see meshes/x500/README.md.
    Inertia, total mass, main collision box, IMU and the stereo baseline are
    unchanged. Landing-gear collisions let the drone rest on its skids, and the
    stereo camera hangs under the payload rails so it clears the propellers.

    Flight: the quadrotor_dynamics plugin at the end of this file computes rotor
    thrust, reaction torques, aerodynamic drag, wind and ground effect, and runs
    the onboard flight controller (see src/flight/ and docs/FLIGHT_DYNAMICS.md).
  -->

  <!-- Wind (world frame, m/s), set from simulation.launch.py -->
  <xacro:arg name="wind_x" default="0.0"/>
  <xacro:arg name="wind_y" default="0.0"/>
  <xacro:arg name="wind_z" default="0.0"/>
  <xacro:arg name="wind_gust_stddev" default="0.0"/>

  <!-- Property definitions -->
  <!--
    Absolute file:// URIs work in both Gazebo and RViz without adding the
    install share/ directory to GAZEBO_MODEL_PATH (which makes gzclient's
    Insert tab log "Missing model.config" for every package in it).
  -->
  <xacro:property name="mesh_dir" value="file://$(find interceptor_drone)/meshes/x500"/>
  <xacro:property name="camera_mass" value="0.1"/>
  <xacro:property name="baseline" value="0.12"/>
  <!-- Stereo camera housing (ZED 2 class: 175 mm wide for a 120 mm baseline) -->
  <xacro:property name="camera_width" value="0.175"/>
  <xacro:property name="camera_height" value="0.03"/>
  <xacro:property name="camera_depth" value="0.033"/>
  <xacro:property name="motor_offset" value="0.174"/>
  <!-- Upstream x500 props are 13" meshes scaled to 11" -->
  <xacro:property name="prop_scale" value="0.8461538461538461"/>

  <!-- Base link: frame mesh (inertia and main collision unchanged for physics) -->
  <link name="base_link">
    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.0343" ixy="0.0" ixz="0.0" iyy="0.0343" iyz="0.0" izz="0.0667"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 ${pi}"/>
      <geometry>
        <mesh filename="${mesh_dir}/x500_frame.dae"/>
      </geometry>
    </visual>
    <collision>
      <!-- Keep original bounding box for physics accuracy -->
      <geometry>
        <box size="0.4 0.4 0.1"/>
      </geometry>
    </collision>
    <!-- Landing gear: two inclined legs and two skids (from the x500 model) -->
    <collision>
      <origin xyz="0 -0.098 -0.123" rpy="-0.35 0 0"/>
      <geometry>
        <box size="0.015 0.015 0.21"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0.098 -0.123" rpy="0.35 0 0"/>
      <geometry>
        <box size="0.015 0.015 0.21"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 -0.132 -0.2195" rpy="0 0 0"/>
      <geometry>
        <box size="0.25 0.015 0.015"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0.132 -0.2195" rpy="0 0 0"/>
      <geometry>
        <box size="0.25 0.015 0.015"/>
      </geometry>
    </collision>
  </link>

  <!--
    Motor + propeller macro (X configuration). The motor stator is a visual of
    the rotor link, the propeller its own link so Gazebo can colour it.
    Visuals stay unnamed: Gazebo Classic only applies <gazebo reference>
    materials to visuals lumped through fixed joints when they keep their
    default names.
    The propeller spins on a continuous joint. Its speed is set by the dynamics
    plugin (visual only, slowed down); thrust is applied to base_link.
  -->
  <xacro:macro name="quad_rotor" params="name x y prop">
    <link name="rotor_${name}">
      <inertial>
        <!-- Motor 0.030 kg + propeller 0.005 kg keeps the total mass of the previous model -->
        <mass value="0.030"/>
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
      </inertial>
      <visual>
        <origin xyz="0 0 -0.028" rpy="0 0 -0.45"/>
        <geometry>
          <mesh filename="${mesh_dir}/5010Base.dae"/>
        </geometry>
      </visual>
      <visual>
        <origin xyz="0 0 -0.032" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/5010Bell.dae"/>
        </geometry>
      </visual>
    </link>
    <joint name="rotor_${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="rotor_${name}"/>
      <origin xyz="${x} ${y} 0.06" rpy="0 0 0"/>
    </joint>

    <link name="prop_${name}">
      <inertial>
        <mass value="0.005"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="3.3e-5" iyz="0" izz="3.3e-5"/>
      </inertial>
      <visual>
        <!-- The prop mesh origin is at its tip, this centres the hub on the motor -->
        <origin xyz="-0.022 -0.14638461538461536 -0.016" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/1345_prop_${prop}.stl"
            scale="${prop_scale} ${prop_scale} ${prop_scale}"/>
        </geometry>
        <material name="prop_dark_grey">
          <color rgba="0.175 0.175 0.175 1"/>
        </material>
      </visual>
    </link>
    <joint name="prop_${name}_joint" type="continuous">
      <parent link="rotor_${name}"/>
      <child link="prop_${name}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
    <gazebo reference="prop_${name}">
      <material>Gazebo/DarkGrey</material>
    </gazebo>
  </xacro:macro>

  <!-- PX4 quad-X numbering: FR and RL spin CCW, FL and RR spin CW -->
  <xacro:quad_rotor name="fr" x="${motor_offset}" y="${-motor_offset}" prop="ccw"/>
  <xacro:quad_rotor name="fl" x="${motor_offset}" y="${motor_offset}" prop="cw"/>
  <xacro:quad_rotor name="rl" x="${-motor_offset}" y="${motor_offset}" prop="ccw"/>
  <xacro:quad_rotor name="rr" x="${-motor_offset}" y="${-motor_offset}" prop="cw"/>

  <!-- IMU link -->
  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0"/>
  </joint>

  <!--
    Stereo camera mount link: housing hung from the front of the payload rails
    (underside z = -0.026, front end x = 0.15), below the propeller discs.
  -->
  <link name="stereo_camera_link">
    <inertial>
      <mass value="${camera_mass}"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry>
        <box size="${camera_depth} ${camera_width} ${camera_height}"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <visual>
      <!-- Bracket plate between the rails and the housing -->
      <origin xyz="-0.0375 0 0.0135" rpy="0 0 0"/>
      <geometry>
        <box size="0.085 0.05 0.003"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${camera_depth} ${camera_width} ${camera_height}"/>
      </geometry>
    </collision>
  </link>
  <gazebo reference="stereo_camera_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <!-- Lens macro: glass disc on the front face, in front of each camera frame -->
  <xacro:macro name="stereo_lens" params="side">
    <link name="stereo_${side}_lens_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 ${pi/2} 0"/>
        <geometry>
          <cylinder radius="0.009" length="0.004"/>
        </geometry>
        <material name="lens_black">
          <color rgba="0.02 0.02 0.03 1"/>
        </material>
      </visual>
    </link>
    <joint name="stereo_${side}_lens_joint" type="fixed">
      <parent link="stereo_${side}_camera_frame"/>
      <child link="stereo_${side}_lens_link"/>
      <origin xyz="${camera_depth/2} 0 0" rpy="0 0 0"/>
    </joint>
    <gazebo reference="stereo_${side}_lens_link">
      <material>Gazebo/Black</material>
    </gazebo>
  </xacro:macro>
  <xacro:stereo_lens side="left"/>
  <xacro:stereo_lens side="right"/>

  <!-- Camera mount joint -->
  <joint name="camera_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="stereo_camera_link"/>
    <origin xyz="0.2 0 -0.0375" rpy="0 0 0"/>
  </joint>

  <!-- Left camera optical frame -->
  <link name="stereo_left_camera_frame"/>
  <joint name="stereo_left_camera_joint" type="fixed">
    <parent link="stereo_camera_link"/>
    <child link="stereo_left_camera_frame"/>
    <origin xyz="0 ${-baseline/2} 0" rpy="0 0 0"/>
  </joint>

  <!-- Right camera optical frame -->
  <link name="stereo_right_camera_frame"/>
  <joint name="stereo_right_camera_joint" type="fixed">
    <parent link="stereo_camera_link"/>
    <child link="stereo_right_camera_frame"/>
    <origin xyz="0 ${baseline/2} 0" rpy="0 0 0"/>
  </joint>

  <!-- Left camera optical link (ROS convention: Z forward, X right, Y down) -->
  <link name="stereo_left_camera_optical_frame"/>
  <joint name="stereo_left_camera_optical_joint" type="fixed">
    <parent link="stereo_left_camera_frame"/>
    <child link="stereo_left_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- Right camera optical link -->
  <link name="stereo_right_camera_optical_frame"/>
  <joint name="stereo_right_camera_optical_joint" type="fixed">
    <parent link="stereo_right_camera_frame"/>
    <child link="stereo_right_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- Gazebo plugins (base_link has no material override: the frame mesh carries its own) -->

  <!-- Left camera sensor -->
  <gazebo reference="stereo_left_camera_frame">
    <sensor type="camera" name="stereo_left_camera">
      <update_rate>60</update_rate>
      <camera name="stereo_left">
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.5</near>
          <far>100</far>
        </clip>
        <distortion>
          <k1>0.0</k1>
          <k2>0.0</k2>
          <k3>0.0</k3>
          <p1>0.0</p1>
          <p2>0.0</p2>
        </distortion>
      </camera>
      <plugin name="stereo_left_camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>stereo</namespace>
          <remapping>stereo_left_camera/image_raw:=left/image_raw</remapping>
          <remapping>stereo_left_camera/camera_info:=left/camera_info</remapping>
        </ros>
        <frame_name>stereo_left_camera_optical_frame</frame_name>
        <hack_baseline>0.0</hack_baseline>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Right camera sensor -->
  <gazebo reference="stereo_right_camera_frame">
    <sensor type="camera" name="stereo_right_camera">
      <update_rate>60</update_rate>
      <camera name="stereo_right">
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.5</near>
          <far>100</far>
        </clip>
        <distortion>
          <k1>0.0</k1>
          <k2>0.0</k2>
          <k3>0.0</k3>
          <p1>0.0</p1>
          <p2>0.0</p2>
        </distortion>
      </camera>
      <plugin name="stereo_right_camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>stereo</namespace>
          <remapping>stereo_right_camera/image_raw:=right/image_raw</remapping>
          <remapping>stereo_right_camera/camera_info:=right/camera_info</remapping>
        </ros>
        <frame_name>stereo_right_camera_optical_frame</frame_name>
        <hack_baseline>0.12</hack_baseline>
      </plugin>
    </sensor>
  </gazebo>

  <!-- IMU plugin -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <!-- gazebo_ros_imu_sensor reads the noise model of all six axes at load time and
           logs "Get noise index not valid" for each one that is not defined -->
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/imu</namespace>
          <remapping>~/out:=data</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
        <frame_name>imu_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!--
    Flight dynamics + onboard flight controller.
    Rotor coefficients are the PX4 x500 SITL values. Mass and inertia are read
    from this model, rotor positions from the prop joints.
    Topics: cmd_vel (in), drone/arm (in), drone/set_wind (in), odom, joint_states,
    drone/status, drone/wind (out), TF odom -> base_link.
  -->
  <gazebo>
    <plugin name="quadrotor_dynamics" filename="libquadrotor_dynamics_plugin.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <body_link>base_link</body_link>
      <rotor><joint>prop_fr_joint</joint><direction>ccw</direction></rotor>
      <rotor><joint>prop_fl_joint</joint><direction>cw</direction></rotor>
      <rotor><joint>prop_rl_joint</joint><direction>ccw</direction></rotor>
      <rotor><joint>prop_rr_joint</joint><direction>cw</direction></rotor>

      <!-- Rotors: T = k_f w^2, Q = k_m T, first-order motor lag -->
      <thrust_coefficient>8.54858e-06</thrust_coefficient>
      <moment_coefficient>0.016</moment_coefficient>
      <rotor_drag_coefficient>8.06428e-05</rotor_drag_coefficient>
      <rotor_radius>0.1397</rotor_radius>
      <max_rotor_speed>1000.0</max_rotor_speed>
      <motor_time_constant_up>0.0125</motor_time_constant_up>
      <motor_time_constant_down>0.025</motor_time_constant_down>
      <rotor_visual_slowdown>10.0</rotor_visual_slowdown>

      <!-- Aerodynamics -->
      <air_density>1.225</air_density>
      <drag_area>0.04 0.04 0.08</drag_area>
      <angular_drag>0.002</angular_drag>
      <ground_effect>true</ground_effect>
      <ground_height>0.0</ground_height>
      <wind_mean>$(arg wind_x) $(arg wind_y) $(arg wind_z)</wind_mean>
      <wind_gust_stddev>$(arg wind_gust_stddev)</wind_gust_stddev>
      <wind_gust_time_constant>2.0</wind_gust_time_constant>

      <!-- Flight controller -->
      <command_frame>heading</command_frame>
      <command_timeout>0.5</command_timeout>
      <max_horizontal_speed>8.0</max_horizontal_speed>
      <max_vertical_speed>3.0</max_vertical_speed>
      <max_yaw_rate>1.5</max_yaw_rate>
      <max_tilt>0.61</max_tilt>
      <idle_rotor_speed>100.0</idle_rotor_speed>
      <start_armed>false</start_armed>

      <odom_frame>odom</odom_frame>
      <odom_rate>100.0</odom_rate>
      <joint_state_rate>30.0</joint_state_rate>
    </plugin>
  </gazebo>

</robot>
