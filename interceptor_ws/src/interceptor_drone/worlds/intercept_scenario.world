<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="park_intercept">

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Blue sky with clouds -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.53 0.81 0.92 1</background>
      <shadows>true</shadows>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
    </scene>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Park trees (downloaded from Gazebo model DB on first run) -->
    <include>
      <uri>model://oak_tree</uri>
      <name>oak_1</name>
      <pose>20 7 0 0 0 0.5</pose>
    </include>
    <include>
      <uri>model://oak_tree</uri>
      <name>oak_2</name>
      <pose>7 22 0 0 0 1.2</pose>
    </include>
    <include>
      <uri>model://oak_tree</uri>
      <name>oak_3</name>
      <pose>-4 10 0 0 0 2.1</pose>
    </include>
    <include>
      <uri>model://oak_tree</uri>
      <name>oak_4</name>
      <pose>18 23 0 0 0 0.3</pose>
    </include>
    <include>
      <uri>model://oak_tree</uri>
      <name>oak_5</name>
      <pose>24 14 0 0 0 0.8</pose>
    </include>
    <include>
      <uri>model://pine_tree</uri>
      <name>pine_1</name>
      <pose>4 -5 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://pine_tree</uri>
      <name>pine_2</name>
      <pose>27 6 0 0 0 1.5</pose>
    </include>
    <include>
      <uri>model://pine_tree</uri>
      <name>pine_3</name>
      <pose>-3 22 0 0 0 0.7</pose>
    </include>
    <include>
      <uri>model://pine_tree</uri>
      <name>pine_4</name>
      <pose>26 26 0 0 0 2.4</pose>
    </include>

    <!-- Park bench 1 (inline SDF, no external model required) -->
    <model name="bench_1">
      <static>true</static>
      <pose>6 3 0 0 0 0</pose>
      <link name="link">
        <visual name="seat">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><box><size>1.5 0.4 0.05</size></box></geometry>
          <material>
            <ambient>0.4 0.25 0.1 1</ambient>
            <diffuse>0.6 0.4 0.18 1</diffuse>
          </material>
        </visual>
        <visual name="frame">
          <pose>0 0 0.22 0 0 0</pose>
          <geometry><box><size>1.4 0.06 0.44</size></box></geometry>
          <material>
            <ambient>0.2 0.12 0.05 1</ambient>
            <diffuse>0.35 0.22 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><box><size>1.5 0.4 0.5</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Park bench 2 (rotated 90 degrees) -->
    <model name="bench_2">
      <static>true</static>
      <pose>3 12 0 0 0 1.5708</pose>
      <link name="link">
        <visual name="seat">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><box><size>1.5 0.4 0.05</size></box></geometry>
          <material>
            <ambient>0.4 0.25 0.1 1</ambient>
            <diffuse>0.6 0.4 0.18 1</diffuse>
          </material>
        </visual>
        <visual name="frame">
          <pose>0 0 0.22 0 0 0</pose>
          <geometry><box><size>1.4 0.06 0.44</size></box></geometry>
          <material>
            <ambient>0.2 0.12 0.05 1</ambient>
            <diffuse>0.35 0.22 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><box><size>1.5 0.4 0.5</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Concrete footpath running through the park -->
    <model name="footpath">
      <static>true</static>
      <pose>7.5 0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="path">
          <geometry><box><size>15 2 0.01</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>15 2 0.01</size></box></geometry>
        </collision>
      </link>
    </model>

    <!--
      Moving target actor.
      walk.dae ships with Gazebo 11 in the standard media path.
      Trajectory: counter-clockwise 15x15 m patrol with 2 m-radius rounded
      corners at a constant 1.4 m/s (one lap ~40.4 s).
      z=1.0 aligns the walk.dae skeleton root (hip) correctly above ground.

      Gazebo interpolates actor positions with a Catmull-Rom spline and the
      heading with a slerp between consecutive waypoints. With only a few
      sparse corner waypoints the path bulges at the corners and the yaw keeps
      turning through whole legs, so the walker appears to move sideways or
      backwards. The waypoints below are therefore sampled every ~0.59 m
      along the path, with yaw = path tangent at each sample. The yaw is
      unwrapped (pi/2 -> 5*pi/2) so the slerp never takes the long way round.
      Regenerate with a uniform resample rather than hand-editing points.
    -->
    <actor name="target_person">
      <pose>15 2 1.0 0 0 1.5708</pose>
      <skin>
        <filename>walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walking">
        <filename>walk.dae</filename>
        <scale>1.0</scale>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint><time>0.000</time><pose>15.000 2.000 1.0 0 0 1.5708</pose></waypoint>
          <waypoint><time>0.421</time><pose>15.000 2.589 1.0 0 0 1.5708</pose></waypoint>
          <waypoint><time>0.842</time><pose>15.000 3.178 1.0 0 0 1.5708</pose></waypoint>
          <waypoint><time>1.263</time><pose>15.000 3.768 1.0 0 0 1.5708</pose></waypoint>
          <waypoint><time>1.684</time><pose>15.000 4.357 1.0 0 0 1.5708</pose></waypoint>
