# Switch the mission mode, served by mission_manager_node on /mission/set_mode
uint8 mode
uint8 MODE_HOLD=0
uint8 MODE_FOLLOW=1
uint8 MODE_INTERCEPT=2

bool armed          # Operator authorization to engage (INTERCEPT only)
# Operator-selected track, -1 = automatic selection (the default, so a request that
# leaves the field out, e.g. "{mode: 2, armed: true}", selects automatically).
# Tracker ids start at 1, so 0 never names a track and is rejected.
int32 track_id -1
---
bool success
string message
